# Admin (Next.js) — copy to .env and fill in. Never commit real secrets.
# Local dev runs on port 3001.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

MONGO_URI=

# Express API base (Next rewrite for /api/v1/*)
API_URL=http://localhost:5000

# Browser Socket.IO target (must be the public API URL in production)
NEXT_PUBLIC_API_URL=http://localhost:5000

ImageBB_api_key=
